{
	"info": {
		"_postman_id": "primehaven-api-collection",
		"name": "PrimeHaven Microservices API",
		"description": "Complete collection for PrimeHaven Real Estate Microservices via API Gateway (Port 8080)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{jwt_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "jwt_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Auth Service",
			"item": [
				{
					"name": "Login (Generate JWT)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var data = pm.response.json();",
									"if (data.token) {",
									"    pm.collectionVariables.set('jwt_token', data.token);",
									"    console.log('JWT Token stored successfully into collection variable: jwt_token');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"siva_user\",\n  \"role\": \"CLIENT\"\n}"
						},
						"url": {
							"raw": "http://localhost:8080/auth/login",
							"protocol": "http",
							"host": ["localhost"],
							"port": "8080",
							"path": ["auth", "login"]
						}
					}
				}
			]
		},
		{
